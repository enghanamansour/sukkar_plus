# Sukkar Plus — environment template. PLACEHOLDERS ONLY. Never commit real values.
#
# ── Client (public by design; compiled into the app via --dart-define) ──────
# Copy app/dart_defines.example.json to app/dart_defines.json instead of
# exporting these. Leave empty to run the app in demo mode.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DEMO_MODE=false

# ── Server secrets (Supabase Edge Functions only: `supabase secrets set …`) ──
# These must NEVER be placed in the Flutter app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_API_KEY=
# "demo" or "live" — written into the automation payload.
SUKKAR_ENVIRONMENT=demo
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided to
# Edge Functions automatically by Supabase. Do not copy the service-role key anywhere.
